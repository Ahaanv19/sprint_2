    "\n",
    "  <title>Lesson 1.3 Output Game</title>\n",
    "  <style>\n",
    "    body { font-family: Arial, sans-serif; text-align: center; }\n",
    "    .heart { color: red; font-size: 24px; }\n",
    "    #progress { height: 20px; background: lightgray; margin: 10px 0; }\n",
    "    #bar { height: 100%; width: 0; background: purple; }\n",
    "    button { margin: 5px; padding: 10px; }\n",
    "  </style>\n",
    "<body>\n",
    "  <h1>Lesson 1.3: Expressions & Output Game</h1>\n",
    "  <div id=\"lives\"></div>\n",
    "  <div id=\"progress\"><div id=\"bar\"></div></div>\n",
    "\n",
    "  <p id=\"question\"></p>\n",
    "  <div id=\"choices\"></div>\n",
    "  <h2 id=\"score\"></h2>\n",
    "  <h2 id=\"end\"></h2>\n",
    "\n",
    "  <script>\n",
    "    const quiz = [\n",
    "      // Output basics\n",
    "      { q: \"Which statement prints output and moves to the next line?\", choices: [\"System.out.print\", \"System.out.println\", \"System.in.read\"], answer: 1 },\n",
    "      { q: \"Which statement prints output without moving to the next line?\", choices: [\"System.out.println\", \"System.out.print\", \"System.printf\"], answer: 1 },\n",
    "      { q: \"What does \\\\n do in a string?\", choices: [\"Adds a tab\", \"Starts a new line\", \"Adds a quote\"], answer: 1 },\n",
    "      { q: \"System.out.println(\\\"2 + 3 = \\\" + (2+3)); → What is printed?\", choices: [\"2 + 3 = 5\", \"2 + 3 = 2+3\", \"5\"], answer: 0 },\n",
    "\n",
    "      // Menu.java tie-in\n",
    "      { q: \"In Menu.java, which method is used to show menu options to the user?\", \n",
    "        choices: [\"System.out.print\", \"System.out.println\", \"System.in\"], answer: 1 },\n",
    "      { q: \"In Menu.java, what does menu.print() actually do?\", \n",
    "        choices: [\"Takes user input\", \"Prints the list of menu choices to the console\", \"Saves data\"], answer: 1 },\n",
    "      { q: \"True or False: Menu.java uses output to communicate available options before asking for input.\", \n",
    "        choices: [\"True\", \"False\"], answer: 0 }\n",
    "    ];\n",
    "\n",
    "    let current = 0;\n",
    "    let score = 0;\n",
    "    let lives = 3;\n",
    "\n",
    "    function updateUI() {\n",
    "      document.getElementById(\"lives\").innerHTML = \"❤️\".repeat(lives);\n",
    "      document.getElementById(\"score\").innerText = \"Score: \" + score;\n",
    "      let progress = ((current) / quiz.length) * 100;\n",
    "      document.getElementById(\"bar\").style.width = progress + \"%\";\n",
    "    }\n",
    "\n",
    "    function loadQuestion() {\n",
    "      if (current >= quiz.length || lives <= 0) {\n",
    "        endGame();\n",
    "        return;\n",
    "      }\n",
    "      document.getElementById(\"question\").innerText = quiz[current].q;\n",
    "      let choicesDiv = document.getElementById(\"choices\");\n",
    "      choicesDiv.innerHTML = \"\";\n",
    "      quiz[current].choices.forEach((choice, i) => {\n",
    "        let btn = document.createElement(\"button\");\n",
    "        btn.innerText = choice;\n",
    "        btn.onclick = () => checkAnswer(i);\n",
    "        choicesDiv.appendChild(btn);\n",
    "      });\n",
    "      updateUI();\n",
    "    }\n",
    "\n",
    "    function checkAnswer(selected) {\n",
    "      if (selected === quiz[current].answer) {\n",
    "        score++;\n",
    "        alert(\"✅ Correct!\");\n",
    "      } else {\n",
    "        lives--;\n",
    "        alert(\"❌ Wrong! Lost a life.\");\n",
    "      }\n",
    "      current++;\n",
    "      loadQuestion();\n",
    "    }\n",
    "\n",
    "    function endGame() {\n",
    "      document.getElementById(\"question\").innerText = \"\";\n",
    "      document.getElementById(\"choices\").innerHTML = \"\";\n",
    "      document.getElementById(\"end\").innerText =\n",
    "        lives > 0 ? \"🎉 You Win! Final Score: \" + score : \"💀 Game Over! Final Score: \" + score;\n",
    "      document.getElementById(\"bar\").style.width = \"100%\";\n",
    "    }\n",
    "\n",
    "    // start game\n",
    "    loadQuestion();\n",
    "  </script>\n",
    "</body>\n",
   ]
  }
